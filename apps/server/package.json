{
  "name": "@gastos/server",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify + tRPC API server for gastos.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@gastos/shared": "workspace:*",
    "@trpc/server": "^11.18.0",
    "fastify": "^5.12.0"
  },
  "devDependencies": {
    "@gastos/config": "workspace:*",
    "eslint": "^10.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
