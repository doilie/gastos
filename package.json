{
  "name": "gastos",
  "version": "0.0.0",
  "private": true,
  "description": "Personal single-user finance app (monorepo root).",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "turbo run lint && pnpm knip",
    "typecheck": "turbo run typecheck",
